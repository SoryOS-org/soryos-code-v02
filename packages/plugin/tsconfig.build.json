{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  // Type-level contract files check the SDK's types, and `gui/host` is the app's and desktop's internal protocol;
  // neither is part of the package.
  "exclude": ["src/**/*.typecheck.ts", "src/gui/host.ts"]
}
